# NextAuth Environment Variables
# Get these from your OAuth providers' developer consoles

# Google OAuth
GOOGLE_ID=
GOOGLE_SECRET=

# GitHub OAuth
GITHUB_ID=
GITHUB_SECRET=

# Microsoft Entra ID (Azure AD)
MICROSOFT_ENTRA_ID=
MICROSOFT_ENTRA_SECRET=
MICROSOFT_ENTRA_TENANT_ID=

# Apple OAuth
APPLE_ID=
APPLE_SECRET=

# NextAuth Secret (run: npx auth secret)
AUTH_SECRET=

# Next.js
NEXTAUTH_URL=http://localhost:3000
